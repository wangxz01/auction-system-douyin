SERVER_PORT=8080
SERVER_MODE=debug

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=auction
DB_PASSWORD=auctionpass
DB_NAME=auction

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_HOURS=72

# =============================================================================
# 【本文件作用】backend/.env.example（环境变量模板）
# =============================================================================
# 作用：给新人或者新环境用的 .env 模板，提交到 Git，方便照抄。
#
# 用法：
#   1. 新人 clone 项目后：cp .env.example .env
#   2. 然后按自己的环境改 .env 里的密码、端口
#
# 为什么有了 .env 还要 .env.example：
#   - .env 不进 Git（含密码），别人 clone 不到，根本不知道要配哪些变量
#   - .env.example 进 Git，但里面只放假数据/默认值，起"清单"作用
#
# 维护原则：
#   每次往 .env 里加了新变量，记得【同步加到 .env.example】，否则别人会漏配。
#   .example 文件里不要写真密码，只放默认值或占位符（如 your_password_here）。
# =============================================================================

