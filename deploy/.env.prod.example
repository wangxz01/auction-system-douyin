SERVER_PORT=8080
SERVER_MODE=release

DB_HOST=mysql
DB_PORT=3306
DB_USER=auction
DB_PASSWORD=replace-with-strong-db-password
DB_NAME=auction
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_HOURS=72

# Replace with your real HTTPS origin.
ALLOWED_ORIGINS=https://YOUR_DOMAIN_HERE

# Existing registered username that should become the super admin.
ADMIN_USERNAMES=admin
